# === База данных ===
DATABASE_URL=postgresql://marvin:marvin@postgres:5432/marvinbot?schema=public
POSTGRES_USER=marvin
POSTGRES_PASSWORD=marvin
POSTGRES_DB=marvinbot

# === Redis (кэш embeddings и классификации) ===
REDIS_URL=redis://redis:6379

# === JWT ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# === Telegram Bot API (уведомления и inline-кнопки) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=marvin-webhook-secret

# === Telegram MTProto / Telethon (опционально, для глубокого парсинга) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELETHON_PROXY_LIST=

# === MarvinBot / бесплатный LLM ===
# Локальный Ollama или совместимый OpenAI-like endpoint (без платных API)
MARVINBOT_URL=http://ollama:11434/v1
MARVINBOT_API_KEY=ollama
MARVINBOT_MODEL=llama3.2
MARVINBOT_TIMEOUT_MS=10000
MARVINBOT_MAX_TOKENS=2000
# Фоллбек-генератор без LLM (всегда доступен)
MARVINBOT_FORCE_LOCAL=false

# === Приложение ===
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
DIGEST_RETENTION_DAYS=30
LOG_LEVEL=info

# === Расписание (Новосибирск UTC+7) ===
CRON_DIGEST="0 6,18 * * *"
CRON_TIMEZONE=Asia/Novosibirsk
CRON_REMINDER_HOURS=2

# === Лимиты ===
MAX_POSTS_PER_DIGEST=10
MAX_POSTS_PER_ARTICLE=5
MAX_ARTICLE_CHARS=2500
MAX_ARTICLE_TOKENS=2000
TELEGRAM_RATE_LIMIT_PER_HOUR=100

# === Demo-режим (мок-посты без реального Telegram) ===
DEMO_MODE=true
DEFAULT_USER_ID=default-user