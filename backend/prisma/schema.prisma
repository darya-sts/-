generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarvinArticle {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  query     String
  tags      String[]
  status    String   @default("draft")
  tokenUsed Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarvinSettings {
  id              String   @id @default(cuid())
  skills          String   @db.Text
  rules           String   @db.Text
  telegramSources String   @db.Text
  updatedAt       DateTime @updatedAt
}

model MarvinAuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String   @db.Text
  tokens    Int      @default(0)
  createdAt DateTime @default(now())
}

/// Telegram-канал для дайджеста MarvinBot Studio
model TelegramSource {
  id         String       @id @default(cuid())
  username   String       @unique
  title      String
  category   String
  weight     Int          @default(1)
  isActive   Boolean      @default(true)
  lastParsed DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  posts      ParsedPost[]
}

model ParsedPost {
  id          String       @id @default(cuid())
  sourceId    String
  source      TelegramSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text        String       @db.Text
  summary     String?      @db.Text
  author      String?
  publishedAt DateTime
  views       Int?
  score       Int          @default(0)
  category    String
  isExpert    Boolean      @default(false)
  contentHash String?
  createdAt   DateTime     @default(now())
  digestItems DigestItem[]

  @@index([score])
  @@index([contentHash])
}

model Digest {
  id        String       @id @default(cuid())
  date      DateTime     @default(now())
  status    String       @default("draft")
  messageId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     DigestItem[]
  articleId String?
}

model DigestItem {
  id       String     @id @default(cuid())
  digestId String
  digest   Digest     @relation(fields: [digestId], references: [id], onDelete: Cascade)
  postId   String
  post     ParsedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  selected Boolean    @default(false)
  order    Int

  @@unique([digestId, postId])
}

/// Пользователь Forge Mill (только заранее созданные аккаунты)
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

/// Сохранённый промт (Prompt Studio)
model Prompt {
  id          String       @id @default(cuid())
  title       String
  request     String       @db.Text
  body        String       @db.Text
  status      String       @default("draft")
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       PromptTask[]

  @@index([createdAt])
}

/// Делегирование промта в Cursor (история заданий)
model PromptTask {
  id              String   @id @default(cuid())
  promptId        String
  prompt          Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  agents          String[]
  agentRoles      String   @db.Text
  modelTier       String
  modelId         String
  publications    String[]
  saveToMemory    Boolean  @default(false)
  memoryItems     String[]
  priority        String   @default("standard")
  deadline        String?
  inputRef        String?  @db.Text
  packageMarkdown String   @db.Text
  pdfPath         String?
  outputPaths     String[]
  status          String   @default("ready")
  createdAt       DateTime @default(now())

  @@index([promptId])
  @@index([createdAt])
}